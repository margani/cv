<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ name }}'s CV</title>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <meta name="description" content="{{ name }}, {{ title }} based in {{ details.location }}."/>
        <style>
{{ fontFaces }}
            /* One page box for screen and print: @page owns the margins, so page 2
               gets the same margin as page 1 instead of a hand-tuned offset. */
            @page {
                size: A4;
                margin: 1.2cm 1cm;
            }
            :root {
                --accent: #0d6efd;
                --text: #212529;
            }
            * {
                box-sizing: border-box;
            }
            html {
                font-size: 13px;
            }
            body {
                margin: 0;
                font-family: "Open Sans", sans-serif;
                line-height: 1.5;
                color: var(--text);
                background: #fff;
            }
            a {
                color: inherit;
                text-decoration: none;
            }
            h1, h2, h3, h4, p, ul {
                margin: 0;
            }
            h1, h2, h3, h4 {
                font-weight: 500;
                line-height: 1.2;
            }
            .sheet {
                width: min(21cm, 100%);
                margin: 15px auto;
                padding: 1.2cm 1cm;
            }
            .name {
                font-size: 1.7rem;
                color: var(--accent);
            }
            .name small {
                font-size: 1rem;
                font-weight: 400;
                color: var(--text);
            }
            .headline {
                font-size: 1rem;
                margin-top: 0.4rem;
            }
            .top {
                display: grid;
                grid-template-columns: 3fr 1fr;
                column-gap: 1rem;
            }
            .intro {
                padding-top: 1rem;
            }
            .intro p {
                margin-bottom: 1rem;
            }
            .section-title {
                font-size: 1.45rem;
                color: var(--accent);
                margin-bottom: 0.4rem;
            }
            .skills {
                padding-left: 2rem;
                padding-bottom: 1rem;
            }
            .contact {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .contact li {
                display: flex;
                align-items: flex-start;
                gap: 0.3rem;
                padding-top: 0.5rem;
                overflow-wrap: anywhere;
            }
            .contact .icon {
                margin-top: 0.2rem;
            }
            .icon {
                flex: none;
                width: 14px;
                height: 14px;
                vertical-align: -2px;
            }
            .stage {
                break-inside: avoid;
                margin-bottom: 0.5rem;
            }
            .stage-title {
                font-size: 1.45rem;
                font-weight: 700;
                display: inline;
            }
            .position-title {
                font-size: 1.15rem;
                font-weight: 700;
                display: inline;
                margin-right: 0.3rem;
            }
            .employer > .stage-title {
                margin-right: 0.3rem;
            }
            .stage.position {
                margin-bottom: 0.4rem;
            }
            .earlier-title {
                margin: 0.4rem 0 0.1rem;
                font-weight: 700;
            }
            .earlier {
                padding-left: 2rem;
                margin-bottom: 0.5rem;
            }
            .earlier .note {
                list-style: none;
                margin-left: -1rem;
                font-style: italic;
            }
            .stage-sub {
                font-size: 1rem;
            }
            .meta {
                padding-bottom: 0.25rem;
            }
            .stage ul {
                padding-left: 2rem;
            }
            .stage.education,
            .stage.project {
                margin-bottom: 0;
            }
            .stage .blurb {
                padding-bottom: 1rem;
            }
            @media (max-width: 640px) {
                .sheet {
                    padding: 16px;
                    margin: 0 auto;
                }
                .top {
                    grid-template-columns: 1fr;
                }
                .top aside {
                    order: -1;
                }
            }
            @media print {
                .sheet {
                    width: auto;
                    margin: 0;
                    padding: 0;
                }
            }
        </style>
    </head>
    <body>
        <main class="sheet">
            <header>
                <h1 class="name">{{ name }} <small>({{ gender }})</small></h1>
                <p class="headline">{{ title }}</p>
            </header>
            <div class="top">
                <div>
                    <section class="intro" aria-label="Summary">
                        {% if isArray(summary) %}
                            {% for paragraph in summary -%}
                                <p>{{ paragraph }}</p>
                            {%- endfor %}
                        {% else %}
                            <p>{{ summary }}</p>
                        {% endif %}
                    </section>
                    <section>
                        <h2 class="section-title">Skills</h2>
                        <ul class="skills">
                            {% for skill in skills -%}
                                {% if skill.label %}
                                    <li><strong>{{ skill.label }}:</strong> {{ skill.items }}</li>
                                {% else %}
                                    <li>{{ skill }}</li>
                                {% endif %}
                            {%- endfor %}
                        </ul>
                    </section>
                </div>
                <aside aria-label="Contact">
                    <ul class="contact">
                        <li>{{ icon('location-outline') }}<span>{{ details.location }}</span></li>
                        <li>{{ icon('at-outline') }}<a href="mailto:{{ details.email }}">{{ details.email }}</a></li>
                        <li>{{ icon('earth') }}<a href="{{ details.website }}">{{ details.website | shortUrl }}</a></li>
                        <li>{{ icon('logo-github') }}<a href="{{ details.github }}">{{ details.github | shortUrl }}</a></li>
                        <li>{{ icon('logo-linkedin') }}<a href="{{ details.linkedIn }}">{{ details.linkedIn | shortUrl }}</a></li>
                        <li>{{ icon('calendar-outline') }}<a href="{{ details.meeting }}">{{ details.meeting | shortUrl }}</a></li>
                        <li>{{ icon('time-outline') }}<span>updated {{ lastUpdated | dateFormat('D MMM YYYY') }}</span></li>
                    </ul>
                </aside>
            </div>
            <section>
                <h2 class="section-title">Employment</h2>
                {% for employment in history.employment -%}
                    {% if employment.positions %}
                        <article class="employer">
                            <h3 class="stage-title">{{ employment.employer }}</h3>
                            <div class="meta">
                                {{ icon('calendar-outline') }}
                                <span>{{ employment.startDate }} - {{ employment.endDate if employment.endDate else "Now" }}{{ employment.endDate | dateDiff(employment.startDate, ' (', ')') if employment.endDate else '' }},</span>
                                {{ icon('location-outline') }}
                                <span>{{ employment.location }}</span>
                            </div>
                            {% for position in employment.positions -%}
                                <section class="stage position">
                                    <h4 class="position-title">{{ position.title }}</h4>
                                    <span class="stage-sub">{{ position.startDate }} - {{ position.endDate if position.endDate else "Now" }}{{ position.endDate | dateDiff(position.startDate, ' (', ')') if position.endDate else '' }}</span>
                                    <ul>
                                        {% for description in position.description -%}
                                            <li>{{ description }}</li>
                                        {%- endfor %}
                                    </ul>
                                </section>
                            {%- endfor %}
                        </article>
                    {% else %}
                        <article class="stage">
                            <h3 class="stage-title">{{ employment.title }}</h3>
                            <span class="stage-sub">{{ employment.employer }}</span>
                            <div class="meta">
                                {{ icon('calendar-outline') }}
                                <span>{{ employment.startDate }} - {{ employment.endDate if employment.endDate else "Now" }}{{ employment.endDate | dateDiff(employment.startDate, ' (', ')') if employment.endDate else '' }},</span>
                                {{ icon('location-outline') }}
                                <span>{{ employment.location }}</span>
                            </div>
                            {% if employment.description %}
                                {% if isArray(employment.description) %}
                                    <ul>
                                        {% for description in employment.description -%}
                                            <li>{{ description }}</li>
                                        {%- endfor %}
                                    </ul>
                                {% else %}
                                    <span>{{ employment.description }}</span>
                                {% endif %}
                            {% endif %}
                        </article>
                    {% endif %}
                {%- endfor %}
                {% if history.earlier %}
                    <h3 class="stage-sub earlier-title">Earlier roles</h3>
                    <ul class="earlier">
                        {% for role in history.earlier -%}
                            {% if role.note %}
                                <li class="note">{{ role.note }}</li>
                            {% else %}
                                <li><strong>{{ role.title }}</strong>, {{ role.employer }}, {{ role.location }} ({{ role.startDate }} - {{ role.endDate }})</li>
                            {% endif %}
                        {%- endfor %}
                    </ul>
                {% endif %}
            </section>
            <section>
                <h2 class="section-title">Education</h2>
                {% for education in history.education -%}
                    <article class="stage education">
                        <h3 class="stage-sub">{{ education.school }}</h3>
                        <div class="stage-sub">{{ education.degree }} in {{ education.field }}</div>
                        {% if education.startDate %}
                            <div class="meta">
                                {{ icon('calendar-outline') }}
                                <span>{{ education.startDate }} - {{ education.endDate if education.endDate else "" }}, </span>
                                {{ icon('location-outline') }}
                                <span>{{ education.location }}</span>
                            </div>
                        {% endif %}
                        <p class="blurb">{{ education.description }}</p>
                    </article>
                {%- endfor %}
            </section>
            {% if projects %}
                <section>
                    <h2 class="section-title">Projects</h2>
                    {% for project in projects -%}
                        <article class="stage project">
                            <h3 class="stage-title">{{ project.title }}</h3>
                            {% if project.url %}(<a href="{{ project.url }}">{{ project.url | shortUrl }}</a>){% endif %}
                            <p class="blurb">{{ project.description }}</p>
                        </article>
                    {%- endfor %}
                </section>
            {% endif %}
        </main>
    </body>
</html>
